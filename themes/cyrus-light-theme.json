  "tokenColors": [
    {
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": {
        "foreground": "#7a6b5d",
        "fontStyle": "italic"
      }
    },
    {
      "scope": "variable",
      "settings": {
        "foreground": "#8c5825"
      }
    },
    {
      "scope": "variable.language",
      "settings": {
        "foreground": "#a65d3b"
      }
    },
    {
      "scope": "variable.parameter",
      "settings": {
        "foreground": "#7a6b5d"
      }
    },
    {
      "scope": [
        "keyword",
        "keyword.control",
        "storage",
        "storage.type"
      ],
      "settings": {
        "foreground": "#cc4411"
      }
    },
    {
      "scope": "keyword.operator",
      "settings": {
        "foreground": "#b36b22"
      }
    },
    {
      "scope": "keyword.other.unit",
      "settings": {
        "foreground": "#8c5825"
      }
    },
    {
      "scope": [
        "constant",
        "constant.language",
        "constant.numeric",
        "constant.character",
        "constant.other"
      ],
      "settings": {
        "foreground": "#8c5825"
      }
    },
    {
      "scope": "constant.language.boolean",
      "settings": {
        "foreground": "#8c5825"
      }
    },
    {
      "scope": [
        "string",
        "string.quoted",
        "string.value"
      ],
      "settings": {
        "foreground": "#a3581c"
      }
    },
    {
      "scope": "string.regexp",
      "settings": {
        "foreground": "#a65d3b"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call",
        "meta.definition.function"
      ],
      "settings": {
        "foreground": "#996611"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.name.namespace",
        "support.class",
        "support.type"
      ],
      "settings": {
        "foreground": "#a3581c"
      }
    },
    {
      "scope": [
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#b36b22"
      }
    },
    {
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#5e5044"
      }
    },
    {
      "scope": "punctuation",
      "settings": {
        "foreground": "#5e5044"
      }
    },
    {
      "scope": "markup.heading",
      "settings": {
        "foreground": "#996611",
        "fontStyle": "bold"
      }
    },
    {
      "scope": "markup.inserted",
      "settings": {
        "foreground": "#a3581c"
      }
    },
    {
      "scope": "markup.deleted",
      "settings": {
        "foreground": "#cc4411"
      }
    },
    {
      "scope": "markup.changed",
      "settings": {
        "foreground": "#996611"
      }
    }
  ]
}
