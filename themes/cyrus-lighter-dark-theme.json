  "tokenColors": [
    {
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": {
        "foreground": "#b39f8f",
        "fontStyle": "italic"
      }
    },
    {
      "scope": "variable",
      "settings": {
        "foreground": "#e3b98f"
      }
    },
    {
      "scope": "variable.language",
      "settings": {
        "foreground": "#e8a488"
      }
    },
    {
      "scope": "variable.parameter",
      "settings": {
        "foreground": "#b39f8f"
      }
    },
    {
      "scope": [
        "keyword",
        "keyword.control",
        "storage",
        "storage.type"
      ],
      "settings": {
        "foreground": "#ff8f66"
      }
    },
    {
      "scope": "keyword.operator",
      "settings": {
        "foreground": "#d9a066"
      }
    },
    {
      "scope": "keyword.other.unit",
      "settings": {
        "foreground": "#e3b98f"
      }
    },
    {
      "scope": [
        "constant",
        "constant.language",
        "constant.numeric",
        "constant.character",
        "constant.other"
      ],
      "settings": {
        "foreground": "#e3b98f"
      }
    },
    {
      "scope": "constant.language.boolean",
      "settings": {
        "foreground": "#e3b98f"
      }
    },
    {
      "scope": [
        "string",
        "string.quoted",
        "string.value"
      ],
      "settings": {
        "foreground": "#f2b880"
      }
    },
    {
      "scope": "string.regexp",
      "settings": {
        "foreground": "#e8a488"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call",
        "meta.definition.function"
      ],
      "settings": {
        "foreground": "#f0c674"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.name.namespace",
        "support.class",
        "support.type"
      ],
      "settings": {
        "foreground": "#f2b880"
      }
    },
    {
      "scope": [
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#d9a066"
      }
    },
    {
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#d8c4b0"
      }
    },
    {
      "scope": "punctuation",
      "settings": {
        "foreground": "#d8c4b0"
      }
    },
    {
      "scope": "markup.heading",
      "settings": {
        "foreground": "#f0c674",
        "fontStyle": "bold"
      }
    },
    {
      "scope": "markup.inserted",
      "settings": {
        "foreground": "#f2b880"
      }
    },
    {
      "scope": "markup.deleted",
      "settings": {
        "foreground": "#ff8f66"
      }
    },
    {
      "scope": "markup.changed",
      "settings": {
        "foreground": "#f0c674"
      }
    }
  ]
}
