{
  "name": "cyrus-language",
  "displayName": "Cyrus Programming Language",
  "description": "The Cyrus Programming Language",
  "version": "0.0.45",
  "engines": {
    "vscode": "^1.96.0"
  },
  "publisher": "cyrus-lang-tools",
  "icon": "images/logo.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/cyrus-lang/Vscode-Extension"
  },
  "scripts": {
    "test": "vscode-test",
    "publish": "vsce publish",
    "package": "vsce package"
  },
  "categories": [
    "Programming Languages"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onLanguage:cyrus",
    "onStartupFinished"
  ],
  "contributes": {
    "breakpoints": [
      {
        "language": "cyrus"
      }
    ],
    "taskDefinitions": [
      {
        "type": "cyrus",
        "properties": {
          "task": {
            "type": "string"
          }
        }
      }
    ],
    "snippets": [
      {
        "language": "cyrus",
        "path": "./snippets/variables.code-snippets"
      },
      {
        "language": "cyrus",
        "path": "./snippets/functions.code-snippets"
      },
      {
        "language": "cyrus",
        "path": "./snippets/conditionals.code-snippets"
      },
      {
        "language": "cyrus",
        "path": "./snippets/loops.code-snippets"
      },
      {
        "language": "cyrus",
        "path": "./snippets/structs.code-snippets"
      },
      {
        "language": "cyrus",
        "path": "./snippets/enums.code-snippets"
      },
      {
        "language": "cyrus",
        "path": "./snippets/unions.code-snippets"
      },
      {
        "language": "cyrus",
        "path": "./snippets/tuples.code-snippets"
      },
      {
        "language": "cyrus",
        "path": "./snippets/modules.code-snippets"
      },
      {
        "language": "cyrus",
        "path": "./snippets/imports.code-snippets"
      },
      {
        "language": "cyrus",
        "path": "./snippets/misc.code-snippets"
      },
      {
        "language": "cyrus",
        "path": "./snippets/attributes.code-snippets"
      },
      {
        "language": "cyrus",
        "path": "./snippets/memory.code-snippets"
      }
    ],
    "languages": [
      {
        "id": "cyrus",
        "aliases": [
          "Cyrus"
        ],
        "extensions": [
          ".cyrus"
        ],
        "icon": {
          "light": "./images/logo-transparent-light.png",
          "dark": "./images/logo-transparent-dark.png"
        },
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "cyrus",
        "scopeName": "source.cyrus",
        "path": "./syntaxes/cyrus.tmLanguage.json"
      }
    ],
    "debuggers": [
      {
        "type": "lldb",
        "label": "Cyrus LLDB Debugger",
        "languages": [
          "cyrus"
        ],
        "initialConfigurations": [
          {
            "type": "lldb",
            "request": "launch",
            "name": "Debug Cyrus Binary",
            "program": "${workspaceFolder}/main",
            "args": [],
            "cwd": "${workspaceFolder}"
          }
        ],
        "configurationSnippets": [
          {
            "label": "Cyrus: LLDB Launch",
            "description": "Debug Cyrus binary using LLDB",
            "body": {
              "type": "lldb",
              "request": "launch",
              "name": "${1:Debug Cyrus Program}",
              "program": "${workspaceFolder}/${2:main}",
              "args": [],
              "cwd": "${workspaceFolder}"
            }
          }
        ]
      }
    ],
    "themes": [
      {
        "label": "Cyrus Dark",
        "uiTheme": "vs-dark",
        "path": "./themes/cyrus-dark-theme.json"
      },
      {
        "label": "Cyrus Lighter Dark",
        "uiTheme": "vs-dark",
        "path": "./themes/cyrus-lighter-dark-theme.json"
      },
      {
        "label": "Cyrus Light",
        "uiTheme": "vs",
        "path": "./themes/cyrus-light-theme.json"
      }
    ]
  },
  "devDependencies": {
    "@vscode/test-cli": "^0.0.10",
    "@vscode/test-electron": "^2.5.2",
    "vsce": "^2.15.0"
  }
}
